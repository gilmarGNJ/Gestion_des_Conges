rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAllowedOwner(userId) {
      return signedInAs(userId)
        && userId == 'I31iPzHCDtO3DjOfnYHDbIavY8p2'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function validStateDocument() {
      return request.resource.data.keys().hasAll([
          'state',
          'schemaVersion',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'state',
          'schemaVersion',
          'updatedAt'
        ])
        && request.resource.data.state is map
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt == request.time;
    }

    match /userCalendars/{userId} {
      allow read: if isAllowedOwner(userId);
      allow create, update: if isAllowedOwner(userId) && validStateDocument();
      allow delete: if isAllowedOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
